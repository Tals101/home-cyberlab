{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSCloudTrailAclCheck",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::cloud-security-operator-lab-[REDACTED-AWS-ACCOUNT]-us-east-1",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:us-east-1:[REDACTED-AWS-ACCOUNT]:trail/cloud-security-operator-trail"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWrite",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::cloud-security-operator-lab-[REDACTED-AWS-ACCOUNT]-us-east-1/AWSLogs/[REDACTED-AWS-ACCOUNT]/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:us-east-1:[REDACTED-AWS-ACCOUNT]:trail/cloud-security-operator-trail"
        }
      }
    }
  ]
}
